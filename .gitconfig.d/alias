[alias]
	a  = add
	af = a --force


	b   = branch
	ba  = b --all
	bd  = b --delete
	bdd = bd --force
	bm  = b --merged
	bnm = b --no-merged


	branchname = get-branch


	c   = commit
	ca  = c --all
	cam = ca -m

	clone = cl
	cl    = clone --recursive
	cls   = cl --shallow-submodules


	co  = checkout
	cob = checkout -b


	cp = "!_git_cp() { git commit --all --message=\"${1-Update}\"; }; _git_cp"


	d  = diff --color=auto --color-moved=zebra --color-moved-ws=ignore-all-space --ws-error-highlight=all --ignore-blank-lines --ignore-space-change
	dw = d --ignore-all-space --ignore-cr-at-eol --ignore-space-at-eol

	diff-ws = dw


	ds = describe

	# Delete any branches that have been merged into the current branch
	# See also: https://gist.github.com/robmiller/5133264
	dm = "!_git_dm() { git pl && git branch --color=never --format '%(refname:lstrip=2)' --merged | grep -Ev \"^(origin/)?$(git get-branch)$\" | xargs --max-args=1 git bd 2> /dev/null; }; _git_dm"


	fetch = f
	f     = fetch --prune --prune-tags --no-tags
	fa    = f --all

	prune = fa


	find = "!_git_find() { BRANCH=\"$(git get-branch)\"; [[ -z \"${BRANCH}\" ]] && echo \"Error : No branch detected\" && return; git ls-tree -r --name-only \"${BRANCH}\" | grep -Ei \"${1}\"; }; _git_find"

	# Fix upstream
	fu = "!_git_fu() { BRANCH=\"$(git get-branch)\"; [[ -z \"${BRANCH}\" ]] && echo \"Error : No branch detected\" && return; BRANCH_UPSTREAM=\"origin/${BRANCH}\"; git branch --set-upstream-to=\"${BRANCH_UPSTREAM}\" \"${BRANCH}\"; echo \"Set upstream to\" \"${BRANCH_UPSTREAM}\"; }; _git_fu"


	get-branch  = "!_git_gb() { BRANCH=\"$(git symbolic-ref --short HEAD 2> /dev/null)\"; [[ -z \"${BRANCH}\" ]] && BRANCH=\"$(git branch --show-current)\"; echo \"${BRANCH}\"; }; _git_gb"
	get-commit  = rev-parse HEAD
	get-gitdir  = rev-parse --git-dir
	get-repodir = rev-parse --show-toplevel
	get-tags    = describe --tags
	get-url     = !bash "${HOME}/.git-scripts/get-url-any"

	get-url-config = config remote.origin.url


	l                = !bash "${HOME}/.git-scripts/log l"
	ll               = !bash "${HOME}/.git-scripts/log ll"
	ll-author        = !bash "${HOME}/.git-scripts/log ll-author"
	ll-committer     = !bash "${HOME}/.git-scripts/log ll-committer"
	ll-all           = !bash "${HOME}/.git-scripts/log ll-all"
	ll-url           = !bash "${HOME}/.git-scripts/log ll-url"
	ll-url-author    = !bash "${HOME}/.git-scripts/log ll-url-author"
	ll-url-committer = !bash "${HOME}/.git-scripts/log ll-url-committer"
	ll-url-all       = !bash "${HOME}/.git-scripts/log ll-url-all"

	m = merge

	o = !bash "${HOME}/.git-scripts/get-url-any open"


	pull = pl
	pl   = pull --prune --prune-tags --no-tags
	prb  = pl --rebase
	up   = pl --no-rebase
	plu  = "!_git_plu() { BRANCH=\"$(git get-branch)\"; [[ -z \"${BRANCH}\" ]] && echo \"Error : No branch detected\" && return; git f; git co \"${BRANCH}\"; git pl; git s; }; _git_plu"


	push    = ps
	ps      = push --prune --verbose
	ps-noci = ps --push-option=ci.skip
	psf     = "!_git_psf() { BRANCH=\"$(git get-branch)\"; [[ -z \"${BRANCH}\" ]] && echo \"Error : No branch detected\" && return; git ps origin \"${BRANCH}\" --force-with-lease; }; _git_psf"


	r  = reset
	rh  = r --hard HEAD
	rh1 = r --hard HEAD~1
	rs  = r --soft HEAD
	rs1 = r --soft HEAD~1


	s  = status
	si = s --ignored


	sm   = submodule
	smf  = sm foreach --recursive
	smi  = sm update  --recursive --init
	smup = "!_git_smup() { git f; echo; git pl; echo; git smf 'BAR=\"=---------------------------------------------=\"; echo \"${BAR}\"; git plu; echo -e \"${BAR}\\n\\n\"'; }; _git_smup"


	undo = checkout --


	# Requires GitHub CLI (https://hub.github.com/)
	gh-pr = !bash -c 'hub pull-request $0 $@'



