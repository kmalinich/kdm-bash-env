[alias]
	a  = add
	af = a --force


	b   = branch
	ba  = b --all
	bd  = b --delete
	bdd = bd --force
	bm  = b --merged
	bnm = b --no-merged


	branchname = get-branch


	c   = commit
	ca  = c --all
	cam = ca -m

	clone = cl
	cl    = clone --recursive
	cls   = cl --shallow-submodules


	co  = checkout
	cob = checkout -b


	cp = !bash "${HOME}/.git-scripts/cp"


	d  = diff --color=auto --color-moved=zebra --color-moved-ws=ignore-all-space --ws-error-highlight=all --ignore-blank-lines --ignore-space-change
	dw = d --ignore-all-space --ignore-cr-at-eol --ignore-space-at-eol

	diff-ws = dw


	ds = describe

	# Delete any branches that have been merged into the current branch
	# See also: https://gist.github.com/robmiller/5133264
	dm = !bash "${HOME}/.git-scripts/dm"


	fetch = f
	f     = fetch --prune --prune-tags --no-tags
	fa    = f --all

	prune = fa


	find = !bash "${HOME}/.git-scripts/find"

	# Fix upstream
	fu = !bash "${HOME}/.git-scripts/fix-upstream"


	get-branch  = !bash "${HOME}/.git-scripts/get-branch"
	get-url     = !bash "${HOME}/.git-scripts/get-url-any"

	get-commit  = rev-parse HEAD
	get-gitdir  = rev-parse --git-dir
	get-repodir = rev-parse --show-toplevel
	get-tags    = describe --tags

	get-url-config = config remote.origin.url


	l                = !bash "${HOME}/.git-scripts/log l"
	ll               = !bash "${HOME}/.git-scripts/log ll"
	ll-author        = !bash "${HOME}/.git-scripts/log ll-author"
	ll-committer     = !bash "${HOME}/.git-scripts/log ll-committer"
	ll-all           = !bash "${HOME}/.git-scripts/log ll-all"
	ll-url           = !bash "${HOME}/.git-scripts/log ll-url"
	ll-url-author    = !bash "${HOME}/.git-scripts/log ll-url-author"
	ll-url-committer = !bash "${HOME}/.git-scripts/log ll-url-committer"
	ll-url-all       = !bash "${HOME}/.git-scripts/log ll-url-all"

	m = merge

	o = !bash "${HOME}/.git-scripts/get-url-any open"


	pull = pl
	pl   = pull --prune --no-tags
	prb  = pl --rebase
	up   = pl --no-rebase
	plu  = !bash "${HOME}/.git-scripts/plu"


	push    = ps
	ps      = push --prune --verbose
	ps-noci = ps --push-option=ci.skip
	psf     = !bash "${HOME}/.git-scripts/psf"


	r  = reset
	rh  = r --hard HEAD
	rh1 = r --hard HEAD~1
	rs  = r --soft HEAD
	rs1 = r --soft HEAD~1


	s  = status
	si = s --ignored


	sm   = submodule
	smf  = sm foreach --recursive
	smi  = sm update  --recursive --init
	smup = !bash "${HOME}/.git-scripts/smup"


	undo = checkout --


	# Requires GitHub CLI (https://hub.github.com/)
	gh-pr = !bash -c 'hub pull-request $0 $@'



